# Reference https://github.com/github/gitignore/blob/master/Go.gitignore
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.dylib

*.syso

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Dependency directories (remove the comment below to include it)
vendor/

# Go workspace file
go.work

# Compiled Object files, Static and Dynamic libs (Shared Objects)
*.o
*.a
*.so

# OS General
Thumbs.db
.DS_Store

# project
*.cert
*.key
*.log
bin/
.cache/
# Runtime state only: the SQLite database and the RSA password key live in
# ./data. Anchored to the repository root on purpose, so the Go package at
# internal/data stays tracked.
/data/
web/dist

# Compose deployment state: .env holds JWT_SECRET and the admin password, and
# the bind-mount variant keeps the database and RSA key next to it. Only
# .env.example is meant to be committed.
deploy/compose/.env
deploy/compose/data/*
!deploy/compose/data/.keep


# Develop tools
.vscode/
.idea/
*.swp
