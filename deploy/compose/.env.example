# Nagisa netdisk + SeaweedFS, one command:
#
#   cp .env.example .env      # then edit the two secrets marked REQUIRED
#   docker compose up -d
#   open http://127.0.0.1:8000
#
# Full walkthrough, including the object-storage mode trade-off and backups:
#   deploy/compose/README.md
#
# Compose reads this file automatically. Values here always beat the defaults
# baked into the image, so a restart with a changed value is enough to apply it.

name: nagisa

# ---------------------------------------------------------------------------
# Registry（registry-1.docker.io 连不上时必须看这里）
# ---------------------------------------------------------------------------
# 三个基础镜像（node:24-alpine、golang:1.25、alpine:3.21）、对象存储镜像，还有
# 本次构建产出的镜像标签，全部经这个前缀拉取。
#
#   REGISTRY_MIRROR=                     -> 直连 docker.io（网络通畅时留空即可）
#   REGISTRY_MIRROR=docker.1panel.live/  -> 走镜像站
#
# 注意只填主机名加斜杠，**不要**带 library/：Dockerfile 里已经写成
# `${REGISTRY_MIRROR}library/node:24-alpine`，而 chrislusf/seaweedfs 不属于
# library 命名空间，所以前缀必须停在主机名这一层。
#
# 典型症状：`docker compose up` 报
#   failed to resolve reference "docker.io/chrislusf/seaweedfs:4.05": ... i/o timeout
# 就是 docker.io 不可达，填一个可用的镜像站即可。镜像站会失效，换一个就行；
# 给 Docker 守护进程配 registry-mirrors（/etc/docker/daemon.json）也可以，但那只
# 对 docker.io 生效，且需要重启 docker。
#
# 已验证可用的一个：docker.1panel.live/（2026-09 实测能拉到上面四个镜像）
REGISTRY_MIRROR=docker.1panel.live/

# ---------------------------------------------------------------------------
# Go 模块代理（proxy.golang.org 连不上时必须看这里）
# ---------------------------------------------------------------------------
# 后端阶段要跑 `go mod download`，默认走 proxy.golang.org——它和
# registry-1.docker.io 是同一类问题：大陆网络基本不可达。典型症状：
#
#   go: ariga.io/atlas@v0.36.2-...: Get "https://proxy.golang.org/...":
#       dial tcp 142.250.196.209:443: i/o timeout
#
# 注意这**不影响**镜像拉取：上面 REGISTRY_MIRROR 配好了也照样会在这里失败，
# 因为这是构建容器里的 Go 在下载依赖，走的是另一条链路。
#
#   GOPROXY=                            -> 用镜像里的默认值（proxy.golang.org）
#   GOPROXY=https://goproxy.cn,direct   -> 走 goproxy.cn
#
# `,direct` 是兜底：代理没缓存的模块回落到源码仓库。模块校验仍按 go.sum 进行，
# 不需要改 GOSUMDB——goproxy.cn 会代为转发 sum.golang.org 的校验数据
# （`/sumdb/sum.golang.org/supported` 返回 200）。
#
# 已验证可用的一个：https://goproxy.cn,direct（2026-09 实测，同机 0.25s 返回，
# 且能取到上面报错的那个 ariga.io/atlas 版本）
GOPROXY=https://goproxy.cn,direct

# ---------------------------------------------------------------------------
# Ports on the host
# ---------------------------------------------------------------------------
# 8000 is the only port an end user needs: it serves the web UI, the REST API
# and /docs/ from one origin (so there is no CORS to configure).
NAGISA_HTTP_PORT=8000
# gRPC. Keep it on loopback unless a client lives outside this host.
NAGISA_GRPC_PORT=9000
# SeaweedFS S3 API. Only needed by the browser in presigned mode; harmless but
# unnecessary otherwise.
SEAWEED_S3_PORT=8333

# ---------------------------------------------------------------------------
# Secrets — REQUIRED, do not ship the placeholder values
# ---------------------------------------------------------------------------
# The JWT secret signs access tokens and every signed download/share URL. Left
# empty, the server generates a random one per boot: every token and every
# download link dies on restart, and the log warns about it.
#
# Generate with:  openssl rand -base64 48
JWT_SECRET=change-me-run-openssl-rand-base64-48

# The built-in administrator's password, used only on first start (the seed
# never overwrites an existing account). The password itself is a normal login
# password and is transmitted RSA-encrypted, so this value only ever lives in
# the container environment and the database's bcrypt hash.
#
# Leave it empty to have a random password generated and logged exactly once at
# first start — grep the log for "bootstrap account created with a generated
# password".
ADMIN_PASSWORD=change-me-strong-admin-password

# ---------------------------------------------------------------------------
# Object storage
# ---------------------------------------------------------------------------
# These credentials must match deploy/compose/seaweedfs/s3.json. Change both or
# neither.
S3_ACCESS_KEY=nagisa
S3_SECRET_KEY=nagisa-secret
S3_BUCKET=nagisa

# UPLOAD_MODE decides how bytes reach object storage:
#
#   proxy      Every chunk is relayed by the service (PUT /v1/files/uploads/
#              .../raw). Works from any browser on any address, no CORS, no
#              extra port — at the cost of moving the bytes through Go twice.
#              This is what a fresh `docker compose up` uses, because it is the
#              only mode that cannot surprise you.
#
#   presigned  The client uploads straight to SeaweedFS with a presigned PUT.
#              Faster and cheaper for big files, but it requires the browser to
#              reach SEAWEED_S3_PUBLIC (below) AND SeaweedFS to answer the CORS
#              preflight. See deploy/compose/README.md.
UPLOAD_MODE=proxy

# Which endpoint presigned URLs are signed for. This is the address the
# *browser* uses, not the one the container uses (that is always
# seaweedfs:8333). Leave it empty for proxy mode; set it to the host and port
# that browsers can actually reach when UPLOAD_MODE=presigned.
#
#   single machine     127.0.0.1:8333
#   LAN / server       <server-ip>:8333  or  files.example.com (via a proxy)
S3_PUBLIC_ENDPOINT=

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------
# Absolute base URL for share links and absolute download URLs. Empty means
# every URL the server hands out stays relative, which is correct for LAN IPs,
# localhost and a reverse proxy alike. Set it only when something outside the
# request needs the public address (it must include the scheme, e.g.
# https://netdisk.example.com).
PUBLIC_BASE_URL=

# Extra CORS origins. Same-origin deployment (this compose file) needs none;
# add the Vite dev server origin during frontend work, comma separated.
CORS_ORIGIN=

# Container user. Leave as is for the named volumes below. If you switch to host
# bind mounts, set these to `id -u`/`id -g` so the non-root container can write
# to ./data — see deploy/compose/README.md.
NAGISA_UID=65532
NAGISA_GID=65532
